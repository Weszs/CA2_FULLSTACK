@page "/"

<PageTitle>University Explorer Portal</PageTitle>

<div class="hero-panel">
    <div class="hero-copy">
        <span class="eyebrow">University discovery dashboard</span>
        <h1>University Explorer Portal</h1>
        <p>
            Explore universities around the world, compare countries, and manage your application pipeline from one dashboard.
        </p>
        <div class="action-row">
            <a class="btn btn-primary" href="/university-explorer">Explore universities</a>
            <a class="btn btn-outline-primary" href="/student-applications">View applications</a>
        </div>
    </div>
</div>

<div class="row g-4 mt-3">
    <div class="col-md-4">
        <div class="summary-card">
            <h3>Country insights</h3>
            <p>View country details such as population, capital city, and region before selecting a destination.</p>
        </div>
    </div>
    <div class="col-md-4">
        <div class="summary-card">
            <h3>University search</h3>
            <p>Search universities instantly by country and compare options using a clean, responsive interface.</p>
        </div>
    </div>
    <div class="col-md-4">
        <div class="summary-card">
            <h3>Application tracking</h3>
            <p>Create and update student applications with validation, live feedback, and clear management screens.</p>
        </div>
    </div>
</div>
