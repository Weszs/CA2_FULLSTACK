@using UniversityExplorerPortal.Models

<EditForm Model="Model" OnValidSubmit="HandleValidSubmit">
    <DataAnnotationsValidator />

    <div class="row g-3">
        <div class="col-md-6">
            <label class="form-label">Student Name</label>
            <InputText class="form-control" @bind-Value="Model.StudentName" />
            <ValidationMessage For="() => Model.StudentName" />
        </div>

        <div class="col-md-6">
            <label class="form-label">Email Address</label>
            <InputText type="email" class="form-control" @bind-Value="Model.Email" />
            <ValidationMessage For="() => Model.Email" />
        </div>

        <div class="col-md-6">
            <label class="form-label">Country</label>
            <InputText class="form-control" @bind-Value="Model.Country" />
            <ValidationMessage For="() => Model.Country" />
        </div>

        <div class="col-md-6">
            <label class="form-label">University Name</label>
            <InputText class="form-control" @bind-Value="Model.UniversityName" />
            <ValidationMessage For="() => Model.UniversityName" />
        </div>

        <div class="col-md-6">
            <label class="form-label">Course Name</label>
            <InputText class="form-control" @bind-Value="Model.CourseName" />
            <ValidationMessage For="() => Model.CourseName" />
        </div>

        <div class="col-md-6">
            <label class="form-label">Application Date</label>
            <InputDate class="form-control" @bind-Value="Model.ApplicationDate" />
            <ValidationMessage For="() => Model.ApplicationDate" />
        </div>
    </div>

    <div class="d-flex justify-content-end mt-4">
        <button type="submit" class="btn btn-primary" disabled="@IsSubmitting">
            @(IsSubmitting ? "Saving..." : SubmitLabel)
        </button>
    </div>
</EditForm>

@code {
    [Parameter]
    public StudentApplicationFormModel Model { get; set; } = new();

    [Parameter]
    public EventCallback<StudentApplicationFormModel> OnSubmit { get; set; }

    [Parameter]
    public bool IsSubmitting { get; set; }

    [Parameter]
    public string SubmitLabel { get; set; } = "Save application";

    private async Task HandleValidSubmit()
    {
        await OnSubmit.InvokeAsync(Model);
    }
}
